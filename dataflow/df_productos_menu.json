{
	"name": "df_productos_menu",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "productos_menu_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "productos_menu_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "window1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          producto_id as string,",
				"          nombre_producto as string,",
				"          categoria as string,",
				"          precio_lista as string,",
				"          costo_estimado as string,",
				"          disponible as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(producto_id = trim(producto_id),",
				"          nombre_producto = trim(nombre_producto),",
				"          categoria =  iif(     isNull(categoria) || trim(categoria) == '',     'Sin categoría',     initCap(lower(trim(categoria))) ),",
				"          precio_lista = toDecimal(     regexReplace(toString(precio_lista), '[^0-9.]', '') ),",
				"          costo_estimado = toDecimal(costo_estimado),",
				"          disponible = iif(     lower(trim(disponible)) == 'sí'     || lower(trim(disponible)) == 'si',     'Sí',     'No' ) ) ~> derivedColumn1",
				"derivedColumn1 window(over(producto_id),",
				"     asc(nombre_producto, true),",
				"     columna1 = rowNumber()) ~> window1",
				"window1 filter(columna1 == 1",
				"&& !isNull(producto_id)",
				"&& trim(producto_id) != ''",
				"&& !isNull(nombre_producto)",
				"&& trim(nombre_producto) != ''",
				"&& !isNull(categoria)",
				"&& trim(categoria) != ''",
				"&& !isNull(precio_lista)",
				"&& precio_lista >= 0",
				"&& !isNull(costo_estimado)",
				"&& costo_estimado >= 0) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          producto_id as string,",
				"          nombre_producto as string,",
				"          categoria as string,",
				"          precio_lista as decimal(12,2),",
				"          costo_estimado as decimal(12,2),",
				"          disponible as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          producto_id,",
				"          nombre_producto,",
				"          categoria,",
				"          precio_lista,",
				"          costo_estimado,",
				"          disponible",
				"     )) ~> sink1"
			]
		}
	}
}