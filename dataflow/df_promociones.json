{
	"name": "df_promociones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "promociones_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "promociones_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          promocion_id as string,",
				"          nombre_promocion as string,",
				"          fecha_inicio as string,",
				"          fecha_fin as string,",
				"          porcentaje_descuento as string,",
				"          canal_aplicable as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(promocion_id = trim(promocion_id),",
				"          nombre_promocion = trim(nombre_promocion),",
				"          fecha_inicio = toDate(fecha_inicio, 'yyyy-MM-dd'),",
				"          fecha_fin = toDate(fecha_fin, 'yyyy-MM-dd'),",
				"          porcentaje_descuento = toDecimal(porcentaje_descuento),",
				"          canal_aplicable = iif(     isNull(canal_aplicable) || trim(canal_aplicable) == '',     'Todos',     iif(         lower(trim(canal_aplicable)) == 'app',         'Aplicación',         initCap(lower(trim(canal_aplicable)))     ) )) ~> derivedColumn1",
				"derivedColumn1 filter(!isNull(promocion_id)",
				"&& trim(promocion_id) != ''",
				"&& !isNull(nombre_promocion)",
				"&& trim(nombre_promocion) != ''",
				"&& !isNull(fecha_inicio)",
				"&& !isNull(fecha_fin)",
				"&& fecha_fin >= fecha_inicio",
				"&& !isNull(porcentaje_descuento)",
				"&& porcentaje_descuento >= 0",
				"&& porcentaje_descuento <= 100",
				"&& !isNull(canal_aplicable)",
				"&& trim(canal_aplicable) != '') ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          promocion_id as string,",
				"          nombre_promocion as string,",
				"          fecha_inicio as date,",
				"          fecha_fin as date,",
				"          porcentaje_descuento as decimal(5,2),",
				"          canal_aplicable as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          promocion_id,",
				"          nombre_promocion,",
				"          fecha_inicio,",
				"          fecha_fin,",
				"          porcentaje_descuento,",
				"          canal_aplicable",
				"     )) ~> sink1"
			]
		}
	}
}