{
	"name": "df_detalle_pedidos_csv",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "detalle_pedidos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "detalle_pedidos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          detalle_id as string,",
				"          pedido_id as string,",
				"          producto_id as string,",
				"          cantidad as string,",
				"          precio_unitario as string,",
				"          descuento_linea as string,",
				"          total_linea as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(detalle_id = trim(detalle_id),",
				"          pedido_id = trim(pedido_id),",
				"          producto_id = trim(producto_id),",
				"          cantidad = toInteger(cantidad),",
				"          precio_unitario = toDecimal(precio_unitario),",
				"          descuento_linea = toDecimal(descuento_linea),",
				"          total_linea = toString(round(toDecimal(cantidad) * toDecimal(precio_unitario) * (1 - toDecimal(descuento_linea) / 100), 2))) ~> derivedColumn1",
				"derivedColumn1 filter(!isNull(detalle_id)",
				"&& trim(detalle_id) != ''",
				"&& !isNull(pedido_id)",
				"&& trim(pedido_id) != ''",
				"&& !isNull(producto_id)",
				"&& trim(producto_id) != ''",
				"&& cantidad > 0",
				"&& precio_unitario >= 0",
				"&& descuento_linea >= 0",
				"&& descuento_linea <= 100",
				"&& pedido_id != 'PED001003'",
				"&& producto_id != 'PRO0090'",
				"&& producto_id != 'PRO9999') ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          detalle_id as string,",
				"          pedido_id as string,",
				"          producto_id as string,",
				"          cantidad as integer,",
				"          precio_unitario as decimal(12,2),",
				"          descuento_linea as decimal(5,2),",
				"          total_linea as decimal(12,2)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          detalle_id,",
				"          pedido_id,",
				"          producto_id,",
				"          cantidad,",
				"          precio_unitario,",
				"          descuento_linea,",
				"          total_linea",
				"     )) ~> sink1"
			]
		}
	}
}