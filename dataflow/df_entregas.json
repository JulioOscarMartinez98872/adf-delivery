{
	"name": "df_entregas",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "entregas_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "entregas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          entrega_id as string,",
				"          pedido_id as string,",
				"          repartidor_id as string,",
				"          hora_salida as string,",
				"          hora_entrega as string,",
				"          tiempo_entrega_min as string,",
				"          distancia_km as string,",
				"          estado_entrega as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(entrega_id = trim(entrega_id),",
				"          pedido_id = trim(pedido_id),",
				"          repartidor_id = trim(repartidor_id),",
				"          hora_salida = trim(hora_salida),",
				"          hora_entrega = trim(hora_entrega),",
				"          tiempo_entrega_min = toInteger(tiempo_entrega_min),",
				"          distancia_km = toDecimal(distancia_km),",
				"          estado_entrega = initCap(lower(trim(estado_entrega)))) ~> derivedColumn1",
				"derivedColumn1 filter(!isNull(entrega_id)",
				"&& trim(entrega_id) != ''",
				"&& !isNull(pedido_id)",
				"&& trim(pedido_id) != ''",
				"&& !isNull(repartidor_id)",
				"&& trim(repartidor_id) != ''",
				"&& repartidor_id != 'REP9999'",
				"&& tiempo_entrega_min > 0",
				"&& !(estado_entrega == 'Entregada' &&",
				"    (isNull(hora_entrega) || trim(hora_entrega) == ''))) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          entrega_id as string,",
				"          pedido_id as string,",
				"          repartidor_id as string,",
				"          hora_salida as timestamp,",
				"          hora_entrega as timestamp,",
				"          tiempo_entrega_min as integer,",
				"          distancia_km as decimal(8,2),",
				"          estado_entrega as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          entrega_id,",
				"          pedido_id,",
				"          repartidor_id,",
				"          hora_salida,",
				"          hora_entrega,",
				"          tiempo_entrega_min,",
				"          distancia_km,",
				"          estado_entrega",
				"     )) ~> sink1"
			]
		}
	}
}