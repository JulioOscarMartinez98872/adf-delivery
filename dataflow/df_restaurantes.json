{
	"name": "df_restaurantes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "restaurantes_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "restaurantes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          restaurante_id as string,",
				"          nombre_restaurante as string,",
				"          tipo_cocina as string,",
				"          calificacion_promedio as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(restaurante_id = trim(restaurante_id),",
				"          nombre_restaurante = trim(nombre_restaurante),",
				"          tipo_cocina = initCap(lower(trim(tipo_cocina))),",
				"          calificacion_promedio = toDecimal(calificacion_promedio),",
				"          activo = iif(     lower(trim(activo)) == 'sí'     || lower(trim(activo)) == 'si',     'Sí',     'No' )) ~> derivedColumn1",
				"derivedColumn1 filter(!isNull(restaurante_id)",
				"&& trim(restaurante_id) != ''",
				"&& !isNull(nombre_restaurante)",
				"&& trim(nombre_restaurante) != ''",
				"&& !isNull(tipo_cocina)",
				"&& trim(tipo_cocina) != ''",
				"&& calificacion_promedio >= 0",
				"&& calificacion_promedio <= 5) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          restaurante_id as string,",
				"          nombre_restaurante as string,",
				"          tipo_cocina as string,",
				"          calificacion_promedio as decimal(3,2),",
				"          activo as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          restaurante_id,",
				"          nombre_restaurante,",
				"          tipo_cocina,",
				"          calificacion_promedio,",
				"          activo",
				"     )) ~> sink1"
			]
		}
	}
}