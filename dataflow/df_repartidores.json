{
	"name": "df_repartidores",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "repartidores_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "repartidores_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          repartidor_id as string,",
				"          nombre_repartidor as string,",
				"          tipo_vehiculo as string,",
				"          ciudad_base as string,",
				"          fecha_alta as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(repartidor_id = trim(repartidor_id),",
				"          nombre_repartidor = trim(nombre_repartidor),",
				"          tipo_vehiculo = initCap(lower(trim(tipo_vehiculo))),",
				"          ciudad_base = initCap(lower(trim(ciudad_base))),",
				"          fecha_alta =  iif(     regexMatch(trim(fecha_alta), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),     toDate(trim(fecha_alta), 'yyyy-MM-dd'),     toDate(trim(fecha_alta), 'dd/MM/yyyy') ),",
				"          activo = iif(     lower(trim(activo)) == 'sí'     || lower(trim(activo)) == 'si',     'Sí',     'No' )) ~> derivedColumn1",
				"derivedColumn1 filter(!isNull(repartidor_id)",
				"&& trim(repartidor_id) != ''",
				"&& !isNull(nombre_repartidor)",
				"&& trim(nombre_repartidor) != ''",
				"&& !isNull(ciudad_base)",
				"&& trim(ciudad_base) != ''",
				"&& !isNull(fecha_alta)) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          repartidor_id as string,",
				"          nombre_repartidor as string,",
				"          tipo_vehiculo as string,",
				"          ciudad_base as string,",
				"          fecha_alta as date,",
				"          activo as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          repartidor_id,",
				"          nombre_repartidor,",
				"          tipo_vehiculo,",
				"          ciudad_base,",
				"          fecha_alta,",
				"          activo",
				"     )) ~> sink1"
			]
		}
	}
}