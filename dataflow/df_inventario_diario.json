{
	"name": "df_inventario_diario",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "inventario_diario_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "inventario_diario_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          inventario_id as string,",
				"          fecha_inventario as string,",
				"          sucursal_id as string,",
				"          producto_id as string,",
				"          stock_inicial as string,",
				"          entradas as string,",
				"          salidas as string,",
				"          stock_final as string,",
				"          punto_reorden as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(inventario_id = trim(inventario_id),",
				"          fecha_inventario = toDate(fecha_inventario, 'yyyy-MM-dd'),",
				"          sucursal_id = trim(sucursal_id),",
				"          producto_id = trim(producto_id),",
				"          stock_inicial = toInteger(stock_inicial),",
				"          entradas = toInteger(entradas),",
				"          salidas = iif(regexMatch(toString(salidas), '^[0-9]+$'), toInteger(salidas), -1),",
				"          stock_final = toInteger(stock_final),",
				"          punto_reorden = toInteger(punto_reorden)) ~> derivedColumn1",
				"derivedColumn1 filter(!isNull(inventario_id)",
				"&& trim(inventario_id) != ''",
				"&& !isNull(fecha_inventario)",
				"&& !isNull(sucursal_id)",
				"&& trim(sucursal_id) != ''",
				"&& !isNull(producto_id)",
				"&& trim(producto_id) != ''",
				"&& producto_id != 'PRO9999'",
				"&& stock_inicial >= 0",
				"&& entradas >= 0",
				"&& salidas >= 0",
				"&& stock_final >= 0",
				"&& punto_reorden >= 0",
				"&& stock_final == stock_inicial + entradas - salidas) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          inventario_id as string,",
				"          fecha_inventario as date,",
				"          sucursal_id as string,",
				"          producto_id as string,",
				"          stock_inicial as integer,",
				"          entradas as integer,",
				"          salidas as integer,",
				"          stock_final as integer,",
				"          punto_reorden as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          inventario_id,",
				"          fecha_inventario,",
				"          sucursal_id,",
				"          producto_id,",
				"          stock_inicial,",
				"          entradas,",
				"          salidas,",
				"          stock_final,",
				"          punto_reorden",
				"     )) ~> sink1"
			]
		}
	}
}